{
  "expo": {
    "name": "Junquero",
    "slug": "junquero",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "junquero",
    "userInterfaceStyle": "light",
    "android": {
      "package": "app.junquero",
      "adaptiveIcon": {
        "backgroundColor": "#8F2F22",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      ["expo-splash-screen", { "backgroundColor": "#F4EEE6", "image": "./assets/images/splash-icon.png", "imageWidth": 120 }],
      ["expo-camera", { "cameraPermission": "Junquero usa la cámara para tu selfie de verificación y las fotos del trabajo." }],
      ["expo-location", { "locationWhenInUsePermission": "Junquero usa tu ubicación para mostrarte changas cerca." }],
      ["expo-image-picker", { "photosPermission": "Junquero necesita tus fotos para adjuntarlas." }],
      "expo-notifications",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
