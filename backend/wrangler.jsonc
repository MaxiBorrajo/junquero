{
  "name": "junquero-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "junquero",
      "database_id": "1ab6e7a7-eb33-4e4c-bb20-990bb32da75d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "junquero" }],
  "ratelimits": [
    { "name": "RELAY_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "FILE_LIMITER", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": { "CONFIRMATIONS": "2", "BLOCK_CHUNK": "10", "CHUNKS_PER_RUN": "6", "TASK_BATCH": "40", "TASK_MAX_SENDS": "5", "REQUIRE_VERIFIED_APPLICANT": "false", "ADMIN_ADDRESSES": "0x4E5e9eE0aAAbDA5B4e6118EE20e1bBe68b136511" }
}
